class Solution(object):
    def moveZeroes(self, nums):
        """
        :type nums: List[int]
        :rtype: None Do not return anything, modify nums in-place instead.
        """
        x=0
        v=0
        while x<len(nums):
            if nums[x]==0:
                nums.pop(x)
                nums.append(0)
                v+=1
                if v>len(nums):
                    break
            else:
                x+=1