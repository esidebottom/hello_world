class Solution:
    def countValidSelections(self, nums: List[int]) -> int:
        l=len(nums)
        count=0
        for x in range(l):
            if nums[x]==0:
                if sum(nums[x:])==sum(nums[:x]): 
                    count+=2
                if sum(nums[x:])==sum(nums[:x])-1 or sum(nums[x:])==sum(nums[:x])+1:
                    count+=1
        return(count)
            

