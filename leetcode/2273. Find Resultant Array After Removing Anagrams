class Solution(object):
    def removeAnagrams(self, words):
        """
        :type words: List[str]
        :rtype: List[str]
        """
        x=(len(words)-1)
        while x>0:
            if sorted(words[x])==sorted(words[x-1]):
                words.pop(x)
                x-=1
            else:
                x-=1
        return(words)