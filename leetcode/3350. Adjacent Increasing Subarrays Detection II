class Solution:
    def maxIncreasingSubarrays(self, nums: List[int]) -> int:
        k=0
        v=0
        q=[0]*len(nums)
        for x in range(1,len(nums)):
            if nums[x]>nums[x-1]:
                q[x]=1
                
        for x in range(len(nums)):
            if q[x]!=0:
                q[x]+=q[x-1]
        for x in range(len(nums)-2,0,-1):
            if q[x+1]>q[x] and q[x]!=0:
                q[x]=q[x+1]
        print(q)
        
        for x in range(1,len(nums)-1):
            if q[x]==0:
                if q[x+1]>q[x-1]:
                    if q[x-1]>k:
                        k=q[x-1]
                elif q[x-1]>q[x+1]:
                    if q[x+1]>k:
                        k=q[x+1]
                elif q[x-1]==q[x+1]:
                    if q[x+1]>k:
                        k=q[x+1]
        print(k)
        return(max([int((1+max(q))/2),k+1]))
                

    
            