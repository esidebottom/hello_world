class Solution:
    def romanToInt(self, s: str) -> int:
        total=0
        x=0
        numerals={
            "I":1,
            "V":5,
            "X":10,
            "L":50,
            "C":100,
            "D":500,
            "M":1000
        }
        while x < len(s):
            if x+1 < len(s) and (
                s[x] == "I" and s[x+1] in ("V","X") or
                s[x] == "X" and s[x+1] in ("L","C") or
                s[x] == "C" and s[x+1] in ("M","D")
            ):
                total += numerals[s[x+1]] - numerals[s[x]]
                x += 2
            else:
                total += numerals[s[x]]
                x += 1
        return(total)