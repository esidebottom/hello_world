class Solution:
    def isPalindrome(self, x: int) -> bool:
        s=str(x)
        l=0
        r=len(s)-1
        while r>l:
            if s[l]==s[r]:
                r-=1
                l+=1
            else:
                return(False)
                break
        return(True)
            
            
            
            
            
    